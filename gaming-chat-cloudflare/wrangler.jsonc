{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gaming-chat",
  "main": "src/index.js",
  "compatibility_date": "2026-10-16",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "CHAT_DB", "class_name": "ChatService" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChatService"] }
  ]
}
